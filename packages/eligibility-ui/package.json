{
  "name": "@kitsa/eligibility-ui",
  "version": "0.2.4",
  "description": "Reusable React components for Eligibility Lab results: interpretation review, the patient waterfall, criterion impact, decision matrix, scenarios and comparisons. No routing, authentication or application code.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@kitsa/eligibility-lab-client": "0.2.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "25.0.1",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  }
}
