{
  "name": "@kitsa/eligibility-lab-showcase",
  "version": "0.2.4",
  "private": true,
  "description": "Eligibility Lab showcase: review the reference protocol's interpretations, run the baseline and scenarios, compare and export, all through the local service.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
